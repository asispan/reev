<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only benchmark hook. Senders need android.permission.DUMP, which adb shell has and ordinary apps
             can't get, so other apps on a test phone can't trigger it or spend the tester's API credits. -->
        <receiver android:name=".BenchReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
